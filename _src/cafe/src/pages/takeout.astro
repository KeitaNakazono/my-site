---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base
  title="テイクアウト予約"
  description="喫茶ひとときのテイクアウト予約ページ。受け取り日時と品物を選んでお申し込みいただけます。"
  current="takeout"
>
  <section class="hero">
    <div class="wrap">
      <h1>テイクアウトのご予約</h1>
      <p class="lead">
        予約なしでもお渡しできますが、詰め合わせと10個以上のご注文は<strong>3日前まで</strong>にご予約ください。
        お急ぎの場合はお電話（099-000-0000）が確実です。
      </p>
      <dl class="facts">
        <div class="fact">
          <dt>受け取り時間</dt>
          <dd><strong>10:00 - 17:30</strong><br />金・土は19:30まで</dd>
        </div>
        <div class="fact">
          <dt>お支払い</dt>
          <dd>受け取り時に店頭で<br />現金・各種QR決済</dd>
        </div>
        <div class="fact">
          <dt>キャンセル</dt>
          <dd>受け取り日の前日までに<br />お電話ください</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <h2>予約フォーム</h2>
        <p>受け取り日時とご注文の品をお知らせください。</p>
      </div>

      <p class="demo-notice" role="note">
        <strong>ここから先は自主制作サンプルのデモです。</strong>
        このフォームは<strong>どこにも送信されません</strong>。入力内容がどこにも保存・送信されないことを確認したうえで、
        入力チェックの動きだけをお試しください。実際のご依頼では、ここからメール送信またはフォームサービスへ接続します。
        個人情報は入力しないでください。
      </p>

      <form class="reserve-form" id="reserveForm" novalidate>
        <div class="field">
          <label for="name">お名前 <span class="req">必須</span></label>
          <input type="text" id="name" name="name" autocomplete="off" required aria-describedby="nameErr" />
          <p class="field-err" id="nameErr"></p>
        </div>

        <div class="field">
          <label for="tel">お電話番号 <span class="req">必須</span></label>
          <input type="tel" id="tel" name="tel" autocomplete="off" inputmode="tel" required aria-describedby="telErr" />
          <p class="field-err" id="telErr"></p>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="date">受け取り日 <span class="req">必須</span></label>
            <input type="date" id="date" name="date" required aria-describedby="dateErr" />
            <p class="field-err" id="dateErr"></p>
          </div>
          <div class="field">
            <label for="time">受け取り時間 <span class="req">必須</span></label>
            <select id="time" name="time" required aria-describedby="timeErr">
              <option value="">選んでください</option>
              <option>10:00 - 11:00</option>
              <option>11:00 - 13:00</option>
              <option>13:00 - 15:00</option>
              <option>15:00 - 17:30</option>
            </select>
            <p class="field-err" id="timeErr"></p>
          </div>
        </div>

        <fieldset class="field" aria-describedby="itemErr">
          <legend>ご注文の品 <span class="req">必須</span></legend>
          <div class="check-grid">
            <label><input type="checkbox" name="item" value="スコーン" /> スコーン</label>
            <label><input type="checkbox" name="item" value="パウンドケーキ" /> パウンドケーキ</label>
            <label><input type="checkbox" name="item" value="クッキー" /> 塩バタークッキー</label>
            <label><input type="checkbox" name="item" value="珈琲" /> 珈琲（ドリンク）</label>
            <label><input type="checkbox" name="item" value="珈琲豆" /> 珈琲豆 100g</label>
            <label><input type="checkbox" name="item" value="詰め合わせ" /> 焼き菓子の詰め合わせ</label>
          </div>
          <p class="field-err" id="itemErr"></p>
        </fieldset>

        <div class="field">
          <label for="note">数量・ご要望</label>
          <textarea id="note" name="note" rows="4" placeholder="例：スコーン3個、詰め合わせ小箱1つ"></textarea>
        </div>

        <button type="submit" class="btn btn--primary">入力内容を確認する（送信されません）</button>

        <p class="form-note" id="formNote" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <h2>受け取りまでの流れ</h2>
      </div>
      <ol class="steps">
        <li>フォームまたはお電話でご予約ください。</li>
        <li>店から確認のご連絡をします（当日中）。</li>
        <li>当日、レジでお名前をお伝えください。お支払いは受け取り時です。</li>
      </ol>
      <div class="cta-row">
        <a class="btn btn--ghost" href={`${base}/menu/`}>メニューに戻る</a>
      </div>
    </div>
  </section>

  <script slot="page-script" is:inline>
    (function () {
      'use strict';

      var form = document.getElementById('reserveForm');
      var note = document.getElementById('formNote');
      if (!form || !note) return;

      var CLOSED_DAY = 3; // 水曜定休

      function q(sel) {
        return form.querySelector(sel);
      }

      function setErr(inputEl, errId, msg) {
        var errEl = document.getElementById(errId);
        if (errEl) errEl.textContent = msg || '';
        if (inputEl) {
          if (msg) {
            inputEl.setAttribute('aria-invalid', 'true');
          } else {
            inputEl.removeAttribute('aria-invalid');
          }
        }
      }

      function todayStr() {
        var d = new Date();
        var m = String(d.getMonth() + 1).padStart(2, '0');
        var day = String(d.getDate()).padStart(2, '0');
        return d.getFullYear() + '-' + m + '-' + day;
      }

      var dateEl = q('#date');
      if (dateEl) dateEl.min = todayStr();

      function validate() {
        var problems = [];

        var nameEl = q('#name');
        var nameMsg = nameEl.value.trim() ? '' : 'お名前を入力してください。';
        setErr(nameEl, 'nameErr', nameMsg);
        if (nameMsg) problems.push(nameEl);

        var telEl = q('#tel');
        var tel = telEl.value.trim();
        var telMsg = '';
        if (!tel) {
          telMsg = 'お電話番号を入力してください。';
        } else if (!/^[0-9()\-\s+]{10,}$/.test(tel)) {
          telMsg = '電話番号は数字で10桁以上入力してください。';
        }
        setErr(telEl, 'telErr', telMsg);
        if (telMsg) problems.push(telEl);

        var dMsg = '';
        if (!dateEl.value) {
          dMsg = '受け取り日を選んでください。';
        } else {
          var parts = dateEl.value.split('-');
          var picked = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
          var today = new Date();
          today.setHours(0, 0, 0, 0);
          if (picked < today) {
            dMsg = '本日以降の日付を選んでください。';
          } else if (picked.getDay() === CLOSED_DAY) {
            dMsg = '水曜日は定休日です。別の日を選んでください。';
          }
        }
        setErr(dateEl, 'dateErr', dMsg);
        if (dMsg) problems.push(dateEl);

        var timeEl = q('#time');
        var tMsg = timeEl.value ? '' : '受け取り時間を選んでください。';
        setErr(timeEl, 'timeErr', tMsg);
        if (tMsg) problems.push(timeEl);

        var checked = form.querySelectorAll('input[name="item"]:checked');
        var firstCheck = form.querySelector('input[name="item"]');
        var iMsg = checked.length > 0 ? '' : 'ご注文の品を1つ以上選んでください。';
        setErr(null, 'itemErr', iMsg);
        if (iMsg) problems.push(firstCheck);

        return problems;
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        note.className = 'form-note';

        var problems = validate();

        if (problems.length > 0) {
          note.classList.add('is-error');
          note.textContent = problems.length + '件、入力を確認してください。';
          if (problems[0] && problems[0].focus) problems[0].focus();
          return;
        }

        note.classList.add('is-ok');
        note.textContent =
          '入力チェックが通りました。これは自主制作サンプルのデモのため、内容はどこにも送信・保存されていません。';
      });

      form.addEventListener(
        'blur',
        function (e) {
          if (e.target && e.target.id && ['name', 'tel', 'date', 'time'].indexOf(e.target.id) >= 0) {
            validate();
          }
        },
        true
      );
    })();
  </script>
</Base>

<style>
  .demo-notice {
    font-family: "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
    font-size: 0.9rem;
    line-height: 1.75;
    background: #fff5e6;
    border: 1px solid #d8a45c;
    border-left: 5px solid #b9762a;
    border-radius: 10px;
    padding: 0.95rem 1.1rem;
    margin-bottom: 1.2rem;
    max-width: 640px;
    color: #4a3a24;
  }

  .reserve-form {
    font-family: "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
    background: #fffdf9;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem;
    display: grid;
    gap: 1.1rem;
    max-width: 640px;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  label,
  legend {
    font-size: 0.9rem;
    color: #4c453b;
  }

  .req {
    font-size: 0.68rem;
    background: var(--accent);
    color: #fff8ee;
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
    margin-left: 0.3rem;
    vertical-align: middle;
  }

  input,
  select,
  textarea {
    font: inherit;
    font-size: 1rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    width: 100%;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 3px solid #8a5a1e;
    outline-offset: 2px;
  }

  [aria-invalid="true"] {
    border-color: #a3402f;
    background: #fff7f5;
  }

  .field-err {
    font-size: 0.84rem;
    color: #8c3323;
    margin: 0;
    min-height: 1em;
  }

  .field-err:empty {
    min-height: 0;
  }

  fieldset {
    border: 0;
  }

  .check-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.5rem;
    margin: 0.4rem 0;
  }

  .check-grid label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--paper-2);
    border-radius: 8px;
    padding: 0.55rem 0.7rem;
    font-size: 0.92rem;
    color: var(--ink);
    cursor: pointer;
  }

  .check-grid input {
    width: auto;
  }

  button.btn {
    cursor: pointer;
    font-size: 1rem;
    justify-self: start;
  }

  .form-note {
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
    min-height: 1.2em;
  }

  .form-note.is-error {
    color: #8c3323;
  }

  .form-note.is-ok {
    color: #3f5139;
  }

  @media (max-width: 620px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
